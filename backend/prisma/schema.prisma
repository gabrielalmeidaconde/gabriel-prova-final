generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Course {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nome         String
  instrutor    String
  dataCadastro DateTime @default(now())
  status       Status   @default(DISPONIVEL)
  adminEmail   String

  @@map("courses")
}

enum Status {
  DISPONIVEL
  CANCELADO
}
