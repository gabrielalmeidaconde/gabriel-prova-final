generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// status: "DISPONIVEL" | "CANCELADO"
model Course {
  id           String   @id @default(cuid())
  codigo       String   @unique
  nome         String
  instrutor    String
  dataCadastro DateTime @default(now())
  status       String   @default("DISPONIVEL")
  adminEmail   String

  @@map("courses")
}
